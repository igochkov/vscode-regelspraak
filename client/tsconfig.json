{
	"compilerOptions": {
		"module": "node16",
		"moduleResolution": "node16",
		"target": "ES2024",
		"lib": [
			"ES2024"
		],
		"outDir": "out",
		"rootDir": "src",
		"sourceMap": true,
		// No skipLibCheck: declaration files are checked here. It was needed
		// only while @types/node was ahead of the extension host — those types
		// pulled in esnext.disposable, which broke vscode-jsonrpc's own
		// LinkedMap declarations (TS2416). With the types pinned to the host's
		// Node major that conflict is gone, and a mismatch between
		// vscode-languageclient and @types/vscode fails the build again
		// instead of surfacing at activation.
		"strict": true
	},
	"include": [
		"src"
	],
	"exclude": [
		"node_modules",
		".vscode-test"
	]
}