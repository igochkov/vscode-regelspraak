	het bezoekersaantal                      Numeriek (geheel getal);
	het uitleenaantal                        Numeriek (geheel getal);
	het actieve ledenaantal                  Numeriek (geheel getal);
	het ledenaantal                          Numeriek (geheel getal);
	de openingsuren                          Numeriek (geheel getal) met eenheid uur;
	de leesdichtheid                         Numeriek (getal) met eenheid pt/m^2;
	de drukbezochte vestiging                kenmerk;
	de spaarvestiging                        kenmerk;
	de overgangsvestiging                    kenmerk;
	de leeszaalvestiging                     kenmerk;

Objecttype de Publicatie (mv: Publicaties)
	de titel (mv: titels)               Tekst;
	het uitgavejaar (mv: uitgavejaren)  Numeriek (geheel getal);
	het jaar uit druk                   Numeriek (geheel getal);
	het drukjaar                        Numeriek (geheel getal);
	het genre                           Genre;
	de genrekorting                     Percentage (geheel getal) met eenheid %;
	het fictiewerk                      kenmerk;

Objecttype de Bundel (mv: Bundels)
	de titel (mv: titels)               Tekst;
	het uitgavejaar (mv: uitgavejaren)  Numeriek (geheel getal);

Objecttype de Bonuspot (mv: Bonuspotten)
	het totale tegoed (mv: tegoeden)  Numeriek (positief geheel getal) met eenheid pt;
	het onverdeelde tegoed            Numeriek (niet-negatief geheel getal) met eenheid pt;
	het deelnemersaantal              Numeriek (geheel getal);
	de gemiddelde inleg               Numeriek (getal met 2 decimalen) met eenheid pt;
	de verdeelsleutel                 Numeriek (getal met 1 decimalen) met eenheid pt;
	de breukfactor                    Numeriek (getal);
	de ruime pot                      kenmerk;

Objecttype de Zending (mv: Zendingen)
	de bezorgdatum            Datum in dagen;
	de bezorgmaand            Numeriek (geheel getal);
	het bezorgjaar            Numeriek (geheel getal);
	de bezorgdag              Numeriek (geheel getal);
	het bezorgtijdstip        Datum en tijd in millisecondes;
	het beloofde tijdstip     Datum en tijd in millisecondes;
	het bezorgvenster         Numeriek (geheel getal) met eenheid milliseconde;
	het gewicht               Numeriek (getal met 3 decimalen) met eenheid kg;
	het weegverschil          Numeriek (getal met 2 decimalen) met eenheid kg;
	de bezorgtermijn          Numeriek (geheel getal) met eenheid dagen;
	de beoordeling            Tekst;
	de vroege zending         kenmerk;
	de stipte zending         kenmerk;
	de late zending           kenmerk;
	de beoordeelbare zending  kenmerk;
	de onbekende zending      kenmerk;
	de feestbezorging         kenmerk;
	de gewone bezorging       kenmerk;
	het nazendingsgeval       kenmerk;
	het herbeoordelingsgeval  kenmerk;

// §3.1.2 — een extensieblok heropent een objecttype dat elders gedeclareerd is,
// desnoods in een ander bestand. De leden erin horen bij het objecttype.
Extensie van objecttype het Lid
	--- leesduo
	de vergelijkingsdatum         Datum in dagen;
	de tweede vergelijkingsdatum  Datum in dagen;

Domein Geldbedrag is van het type Numeriek (getal met 2 decimalen) met eenheid €

Domein Krediet is van het type Numeriek (negatief geheel getal)

Domein Genre is van het type Enumeratie
	'roman'
	'poëzie'
	'naslagwerk'
	'strip'

Eenheidsysteem gewicht
	de milligram (mv: milligrammen)  mg  = 1/1000 g
	de gram (mv: grammen)            g
	de kilogram (mv: kilogrammen)    kg  = 1000 g

Eenheidsysteem lengte
	de meter (mv: meters)  m

Eenheidsysteem munt
	de euro (mv: euros)  EUR  €

Eenheidsysteem leeswaarde
	het leespunt (mv: leespunten)  pt

Dimensie de spaarperiode, bestaande uit de spaarperiodes (na het attribuut met voorzetsel in):
	1. twee periodes geleden
	2. vorige periode
	3. huidige periode

Dimensie de uitvoeringsdimensie, bestaande uit de uitvoeringsdimensies (voor het attribuut zonder voorzetsel):
	1. digitale
	2. papieren

Tijdlijn de spaartermijn heeft tijdvakken van een kwartaal met variabel startpunt;

Tijdlijn het abonnementsjaar heeft tijdvakken van 6 maanden startend op 01-01-2027;

Tijdlijn de leesmaand heeft tijdvakken van een maand startend op dag 1 van de maand;

Tijdlijn het boekjaar heeft tijdvakken van een jaar startend op dag 1 van maand 1;

Tijdlijn de leesweek heeft tijdvakken van een week startend op 04-01-2027;

Tijdlijn het spaarkwartaal heeft tijdvakken van een kwartaal startend op dag 1 van maand 1, 4, 7 en 10;

Parameter de leenlimiet : Numeriek (niet-negatief geheel getal)
Parameter de standaardcontributie : Geldbedrag voor elk jaar;
Parameter de bonusdrempel : Numeriek (geheel getal) met eenheid pt
Parameter de startdrempel : Numeriek (geheel getal) met eenheid pt
Parameter het spaarpercentage : Percentage (geheel getal) met eenheid %
Parameter de eerste kalenderdag : Datum in dagen
Parameter de aanlooptermijn : Numeriek (geheel getal) met eenheid dagen
Parameter het boetetarief : Geldbedrag met eenheid €/dag
Parameter het verhoogde boetetarief : Geldbedrag met eenheid €/dag
Parameter JAARBIJDRAGE : Geldbedrag met eenheid €/jaar

Feittype lidmaatschap van de boekerij
	de vestiging                                   Boekerijvestiging
	het ingeschreven lid (mv: ingeschreven leden)  Lid
	Eén vestiging telt meerdere ingeschreven leden

Feittype beheer van bonuspotten
	de beherende vestiging                           Boekerijvestiging
	de beheerde bonuspot (mv: beheerde bonuspotten)  Bonuspot
	Eén beherende vestiging beheert meerdere beheerde bonuspotten

Feittype verdeling van de bonuspot
	de te verdelen bonuspot                                            Bonuspot
	de spaarder met recht op bonus (mv: spaarders met recht op bonus)  Lid
	Eén te verdelen bonuspot wordt uitgekeerd aan meerdere spaarders met recht op bonus

Feittype toekenning van bonuspotten
	de toegekende bonuspot (mv: toegekende bonuspotten)  Bonuspot
	de ontvanger (mv: ontvangers)                        Lid
	Eén ontvanger spaart in meerdere toegekende bonuspotten

Feittype bezorging van reserveringen
	de bezorgde zending (mv: bezorgde zendingen)  Zending
	de aanvrager                                  Lid
	Eén aanvrager ontvangt meerdere bezorgde zendingen

// §13.3.9 — één rol, want beide kanten van de relatie zijn hetzelfde soort.
Wederkerig feittype leesduo
	de leespartner (mv: leespartners)  Lid
	Eén leespartner heeft één leespartner;

Dagsoort de sluitingsdag (mv: sluitingsdagen);
Dagsoort de inventarisdag (mv: inventarisdagen)
