out
node_modules
.vscode-test
*.tsbuildinfo
*.vsix

# The language server is built from a separate repository. It is linked in
# here for development, and staged in at packaging time. It must never be
# committed to this repo.
server/
client/server

# "regelspraak.server.path" names a build this repository does not own, so it
# is developer-local. `npm test` and the "Language Server E2E Test" launch
# config open `samples/workspace/single-folder/` alone, where an ordinary
# folder-scoped settings.json is read natively. F5 ("Launch Client") opens
# `samples/workspace/sample.code-workspace` instead — two folders together —
# where a folder's own settings.json is invisible to a resource-less
# `getConfiguration()`, so the setting has to sit inside the workspace file's
# own `settings`. `sample.local.code-workspace` is that file: a generated copy
# of the committed, settings-free template, written by `setup:dev` so a
# personal path is never at risk of being committed with it.
samples/workspace/single-folder/.vscode/
samples/sample-wet/.vscode/
samples/workspace/sample.local.code-workspace

# The on-disk cache of externally supplied tables ([R-15]); rebuilt on demand.
.regelspraak/

# Minidumps, where a development host is launched with
# --crash-reporter-directory to diagnose a native abort.
.crash/
