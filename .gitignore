# The Extension Development Host opens samples/, so a developer's
# "regelspraak.server.path" belongs there (see the README). It names a path on
# one machine, to a build this repository does not own.
samples/.vscode/

# The on-disk cache of externally supplied tables ([R-15]); rebuilt on demand.
.regelspraak/
