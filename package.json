{
	"name": "vscode-regelspraak",
	"displayName": "RegelSpraak",
	"description": "Language support for RegelSpraak: semantic highlighting, live validation, completion, hover and outline for .rgs files.",
	"author": {
		"name": "Ivaylo Gochkov",
		"url": "https://github.com/igochkov"
	},
	"license": "Apache-2.0",
	"version": "0.1.0",
	"publisher": "igochkov",
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#1E1B2E",
		"theme": "dark"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/igochkov/vscode-regelspraak.git"
	},
	"bugs": {
		"url": "https://github.com/igochkov/vscode-regelspraak/issues"
	},
	"homepage": "https://github.com/igochkov/vscode-regelspraak#readme",
	"categories": [
		"Programming Languages",
		"Linters"
	],
	"keywords": [
		"regelspraak",
		"rules as code",
		"belastingdienst",
		"rules engine",
		"dutch"
	],
	"engines": {
		"vscode": "^1.100.0"
	},
	"main": "./client/out/extension",
	"activationEvents": [
		"workspaceContains:**/*.rgs"
	],
	"contributes": {
		"languages": [
			{
				"id": "regelspraak",
				"aliases": [
					"RegelSpraak",
					"regelspraak"
				],
				"extensions": [
					".rgs"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "regelspraak",
				"scopeName": "source.regelspraak",
				"path": "./syntaxes/regelspraak.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "regelspraak",
				"path": "./snippets/regelspraak.code-snippets"
			}
		],
		"semanticTokenTypes": [
			{ "id": "objecttype", "description": "Objecttype" },
			{ "id": "attribuut", "description": "Attribuut van een objecttype" },
			{ "id": "kenmerk", "description": "Kenmerk van een objecttype" },
			{ "id": "domein", "description": "Domein" },
			{ "id": "enumwaarde", "description": "Enumeratiewaarde" },
			{ "id": "eenheid", "description": "Eenheid of eenheidsysteem" },
			{ "id": "dimensie", "description": "Dimensie of dimensiewaarde" },
			{ "id": "dagsoort", "description": "Dagsoort" },
			{ "id": "tijdlijn", "description": "Tijdlijn" },
			{ "id": "parameter", "description": "Parameter" },
			{ "id": "feittype", "description": "Feittype" },
			{ "id": "rol", "description": "Rol in een feittype" },
			{ "id": "regel", "description": "Regel of beslistabel" },
			{ "id": "variabele", "description": "Regelvariabele (Daarbij geldt)" }
		],
		"semanticTokenScopes": [
			{
				"language": "regelspraak",
				"scopes": {
					"objecttype": ["entity.name.type.class.regelspraak"],
					"attribuut": ["variable.other.member.regelspraak"],
					"kenmerk": ["entity.other.attribute-name.regelspraak"],
					"domein": ["entity.name.type.regelspraak"],
					"enumwaarde": ["variable.other.enummember.regelspraak"],
					"eenheid": ["keyword.other.unit.regelspraak"],
					"dimensie": ["entity.name.type.enum.regelspraak"],
					"dagsoort": ["support.constant.regelspraak"],
					"tijdlijn": ["entity.name.type.regelspraak"],
					"parameter": ["variable.parameter.regelspraak"],
					"feittype": ["entity.name.type.interface.regelspraak"],
					"rol": ["variable.other.constant.regelspraak"],
					"regel": ["entity.name.function.regelspraak"],
					"variabele": ["variable.other.readwrite.regelspraak"]
				}
			}
		],
		"configuration": {
			"type": "object",
			"title": "RegelSpraak",
			"properties": {
				"regelspraak.server.path": {
					"scope": "machine-overridable",
					"type": "string",
					"default": "",
					"markdownDescription": "Path to the RegelSpraak language server entry point (`server.js`). Absolute, or relative to the first workspace folder. Leave empty to use the language server bundled with the extension."
				},
				"regelspraak.validation.enable": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"description": "Schakelt semantische validatie van RegelSpraak-bestanden in."
				},
				"regelspraak.validation.scope": {
					"scope": "resource",
					"type": "string",
					"enum": [
						"openFiles",
						"workspace"
					],
					"default": "openFiles",
					"description": "Bepaalt of diagnostiek alleen voor geopende bestanden of voor de hele werkruimte wordt gemeld."
				},
				"regelspraak.validation.runOn": {
					"scope": "resource",
					"type": "string",
					"enum": [
						"type",
						"save"
					],
					"default": "type",
					"description": "Bepaalt wanneer diagnostiek opnieuw wordt berekend: tijdens het typen of bij het opslaan."
				},
				"regelspraakLanguageServer.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Traces the communication between VS Code and the language server."
				}
			}
		},
		"configurationDefaults": {
			"editor.semanticTokenColorCustomizations": {
				"[*Light*]": {
					"rules": {
						"objecttype": "#7A3E9D",
						"attribuut": "#2E7D32",
						"enumwaarde": "#2E7D32",
						"kenmerk": "#B65C00",
						"dimensie": "#B65C00",
						"rol": "#0B5CAD",
						"parameter": "#0B5CAD"
					}
				},
				"[*Dark*]": {
					"rules": {
						"objecttype": "#C586C0",
						"attribuut": "#6BB86A",
						"enumwaarde": "#6BB86A",
						"kenmerk": "#E8A857",
						"dimensie": "#E8A857",
						"rol": "#569CD6",
						"parameter": "#569CD6"
					}
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "cd client && npm install",
		"test": "sh ./scripts/e2e.sh",
		"build:icon": "node scripts/build-icon.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/node": "^22",
		"eslint": "^9.13.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}
