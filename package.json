{
	"name": "vscode-regelspraak",
	"displayName": "RegelSpraak",
	"description": "Semantic highlighting, live validation, completion and hover for RegelSpraak.",
	"author": {
		"name": "Ivaylo Gochkov",
		"url": "https://github.com/igochkov"
	},
	"license": "Apache-2.0",
	"version": "0.6.0",
	"publisher": "igochkov",
	"icon": "images/icon.png",
	"galleryBanner": {
		"color": "#F7F5FF",
		"theme": "light"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/igochkov/vscode-regelspraak.git"
	},
	"bugs": {
		"url": "https://github.com/igochkov/vscode-regelspraak/issues"
	},
	"homepage": "https://github.com/igochkov/vscode-regelspraak#readme",
	"categories": [
		"Programming Languages",
		"Linters",
		"Testing"
	],
	"keywords": [
		"regelspraak",
		"rules as code",
		"belastingdienst",
		"rules engine",
		"dutch"
	],
	"engines": {
		"vscode": "^1.101.0"
	},
	"main": "./client/out/extension",
	"activationEvents": [
		"workspaceContains:**/*.rgs"
	],
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "regelspraak",
					"title": "RegelSpraak",
					"icon": "images/activity-bar.svg"
				}
			]
		},
		"views": {
			"regelspraak": [
				{
					"id": "regelspraak.modelExplorer",
					"name": "Modelverkenner",
					"when": "regelspraak.active",
					"icon": "images/activity-bar.svg"
				}
			]
		},
		"viewsWelcome": [
			{
				"view": "regelspraak.modelExplorer",
				"contents": "Nog geen model gevonden.\n\nDe modelverkenner toont de declaraties van elk .rgs-bestand in deze werkmap, gegroepeerd op soort. Open een RegelSpraak-bestand, of kijk in het uitvoerkanaal \"RegelSpraak Language Server\" of de taalserver draait.\n[Taalserver opnieuw starten](command:regelspraak.restartServer)"
			}
		],
		"commands": [
			{
				"command": "regelspraak.formatDocument",
				"title": "Document opmaken",
				"category": "RegelSpraak"
			},
			{
				"command": "regelspraak.showModelExplorer",
				"title": "Modelverkenner tonen",
				"category": "RegelSpraak"
			},
			{
				"command": "regelspraak.showAst",
				"title": "Modelweergave van dit bestand tonen",
				"category": "RegelSpraak"
			},
			{
				"command": "regelspraak.previewBeslistabel",
				"title": "Beslistabelvoorbeeld tonen",
				"category": "RegelSpraak"
			},
			{
				"command": "regelspraak.showUitkomst",
				"title": "Uitkomst van dit testgeval tonen",
				"category": "RegelSpraak"
			},
			{
				"command": "regelspraak.kiesTestgeval",
				"title": "Actief testgeval kiezen",
				"category": "RegelSpraak"
			},
			{
				"command": "regelspraak.showServerLog",
				"title": "Logboek van de taalserver tonen",
				"category": "RegelSpraak"
			},
			{
				"command": "regelspraak.restartServer",
				"title": "Taalserver opnieuw starten",
				"category": "RegelSpraak"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "regelspraak.formatDocument",
					"when": "editorLangId == regelspraak"
				},
				{
					"command": "regelspraak.showAst",
					"when": "editorLangId == regelspraak"
				},
				{
					"command": "regelspraak.previewBeslistabel",
					"when": "editorLangId == regelspraak"
				},
				{
					"command": "regelspraak.showUitkomst",
					"when": "editorLangId == regelspraak"
				}
			],
			"editor/context": [
				{
					"command": "regelspraak.formatDocument",
					"when": "editorLangId == regelspraak",
					"group": "1_modification"
				}
			],
			"editor/title": [
				{
					"command": "regelspraak.showAst",
					"when": "editorLangId == regelspraak"
				}
			]
		},
		"keybindings": [
			{
				"command": "regelspraak.formatDocument",
				"key": "shift+alt+f",
				"when": "editorLangId == regelspraak && editorTextFocus && !editorReadonly"
			}
		],
		"languages": [
			{
				"id": "regelspraak",
				"aliases": [
					"RegelSpraak",
					"regelspraak"
				],
				"extensions": [
					".rgs"
				],
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "regelspraak",
				"scopeName": "source.regelspraak",
				"path": "./syntaxes/regelspraak.tmLanguage.json"
			},
			{
				"scopeName": "markdown.regelspraak.codeblock",
				"path": "./syntaxes/regelspraak.markdown-injection.json",
				"injectTo": [
					"text.html.markdown"
				],
				"embeddedLanguages": {
					"meta.embedded.block.regelspraak": "regelspraak"
				}
			}
		],
		"snippets": [
			{
				"language": "regelspraak",
				"path": "./snippets/regelspraak.code-snippets"
			}
		],
		"semanticTokenTypes": [
			{
				"id": "objecttype",
				"description": "Objecttype"
			},
			{
				"id": "attribuut",
				"description": "Attribuut van een objecttype"
			},
			{
				"id": "kenmerk",
				"description": "Kenmerk van een objecttype"
			},
			{
				"id": "domein",
				"description": "Domein"
			},
			{
				"id": "enumwaarde",
				"description": "Enumeratiewaarde"
			},
			{
				"id": "eenheid",
				"description": "Eenheid of eenheidsysteem"
			},
			{
				"id": "dimensie",
				"description": "Dimensie of dimensiewaarde"
			},
			{
				"id": "dagsoort",
				"description": "Dagsoort"
			},
			{
				"id": "tijdlijn",
				"description": "Tijdlijn"
			},
			{
				"id": "parameter",
				"description": "Parameter"
			},
			{
				"id": "feittype",
				"description": "Feittype"
			},
			{
				"id": "rol",
				"description": "Rol in een feittype"
			},
			{
				"id": "regel",
				"description": "Regel of beslistabel"
			},
			{
				"id": "variabele",
				"description": "Regelvariabele (Daarbij geldt)"
			}
		],
		"semanticTokenScopes": [
			{
				"language": "regelspraak",
				"scopes": {
					"objecttype": [
						"entity.name.type.class.regelspraak"
					],
					"attribuut": [
						"variable.other.member.regelspraak"
					],
					"kenmerk": [
						"variable.other.constant.regelspraak"
					],
					"domein": [
						"entity.name.type.regelspraak"
					],
					"enumwaarde": [
						"variable.other.enummember.regelspraak"
					],
					"eenheid": [
						"keyword.other.unit.regelspraak"
					],
					"dimensie": [
						"entity.name.type.enum.regelspraak"
					],
					"dagsoort": [
						"variable.other.constant.regelspraak"
					],
					"tijdlijn": [
						"entity.name.type.regelspraak"
					],
					"parameter": [
						"variable.parameter.regelspraak"
					],
					"feittype": [
						"entity.name.type.interface.regelspraak"
					],
					"rol": [
						"variable.other.constant.regelspraak"
					],
					"regel": [
						"entity.name.function.regelspraak"
					],
					"variabele": [
						"variable.other.readwrite.regelspraak"
					]
				}
			}
		],
		"configuration": {
			"type": "object",
			"title": "RegelSpraak",
			"properties": {
				"regelspraak.execution.defaultScenario": {
					"scope": "window",
					"type": "string",
					"default": "",
					"markdownDescription": "Het testgeval waartegen **Regel uitvoeren** een regel uitvoert, als `pad/naar/bestand.test.rgs#naam van het testgeval` — het pad relatief ten opzichte van de eerste werkmap. Dit is de gedeelde standaard, bedoeld om mee te committen; **RegelSpraak: Actief testgeval kiezen** overschrijft hem voor dit venster zonder de instelling te wijzigen. Welke van de twee geldt, staat bij de taalstatus van een `.rgs`-bestand."
				},
				"regelspraak.server.path": {
					"scope": "machine-overridable",
					"type": "string",
					"default": "",
					"markdownDescription": "Pad naar het startpunt van de RegelSpraak-taalserver (`server.js`). Absoluut, of relatief ten opzichte van de eerste werkmap. Laat leeg om de taalserver te gebruiken die met de extensie is meegeleverd."
				},
				"regelspraak.validation.enable": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"description": "Schakelt semantische validatie van RegelSpraak-bestanden in."
				},
				"regelspraak.validation.scope": {
					"scope": "resource",
					"type": "string",
					"enum": [
						"openFiles",
						"workspace"
					],
					"enumDescriptions": [
						"Alleen bestanden die in een editor geopend zijn.",
						"Alle .rgs-bestanden in de werkruimte, ook bestanden die niemand heeft geopend."
					],
					"default": "openFiles",
					"description": "Bepaalt of diagnostiek alleen voor geopende bestanden of voor de hele werkruimte wordt gemeld."
				},
				"regelspraak.validation.runOn": {
					"scope": "resource",
					"type": "string",
					"enum": [
						"type",
						"save"
					],
					"default": "type",
					"description": "Bepaalt wanneer diagnostiek opnieuw wordt berekend: tijdens het typen of bij het opslaan."
				},
				"regelspraak.validation.strictPrecision": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"markdownDescription": "Meldt afrondings- en precisieproblemen (`RS401`, `RS402`, `RS403`): een uitkomst met meer decimalen dan het doelattribuut toestaat, een ontbrekende verplichte afronding, en een precisie die niet vastligt. Ook `RS306`, de waarschuwing over een omrekening tussen twee tijdseenheden, die dezelfde vraag stelt."
				},
				"regelspraak.validation.emptyValueHazards": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"markdownDescription": "Meldt plekken waar een lege waarde tot een fout leidt tijdens uitvoering (`RS501` tot en met `RS505`)."
				},
				"regelspraak.format.enable": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"markdownDescription": "Maakt RegelSpraak-bestanden op: inspringing volgens de opbouw van het model, uitgelijnde kolommen in een objecttype, eenheidsysteem of feittype, en uitgelijnde pijpen in een beslistabel. Alleen witruimte verandert; een bestand met een syntaxfout wordt niet opgemaakt."
				},
				"regelspraak.semanticHighlighting.enable": {
					"scope": "resource",
					"type": "boolean",
					"default": true,
					"markdownDescription": "Kleurt namen op wat het model van ze weet: objecttype, attribuut, kenmerk, parameter, rol. Uitgeschakeld kleurt alleen de TextMate-grammatica, die de sleutelwoorden kent maar de namen niet.\n\nDe kleuren zelf komen van het thema; deze extensie stelt er geen in."
				},
				"regelspraak.inlayHints.enable": {
					"scope": "resource",
					"type": "string",
					"enum": [
						"off",
						"types",
						"all"
					],
					"enumDescriptions": [
						"Geen hints.",
						"Het afgeleide type van een regel en van elke variabele uit Daarbij geldt.",
						"Ook het objecttype waar een zijn/hij over gaat."
					],
					"default": "types",
					"markdownDescription": "Toont wat het model afleidt maar de tekst niet zegt: het datatype en de eenheid van een regelresultaat en van een `Daarbij geldt:`-variabele, en met `all` ook het objecttype achter een `zijn` of `hij`. Waar het model het antwoord niet weet, blijft de hint weg."
				},
				"regelspraakLanguageServer.trace.server": {
					"scope": "window",
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "Registreert de communicatie tussen VS Code en de taalserver."
				}
			}
		},
		"configurationDefaults": {
			"[regelspraak]": {
				"editor.wordWrap": "bounded",
				"editor.wordWrapColumn": 100,
				"editor.wrappingIndent": "deepIndent"
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile && npm run bundle",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"lint": "eslint",
		"postinstall": "node scripts/install-nested.mjs client",
		"test": "node ./client/out/test/runTest.js",
		"build:icon": "node scripts/build-icon.mjs",
		"bundle": "node scripts/bundle-client.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/node": "^22",
		"esbuild": "0.28.2",
		"eslint": "^9.13.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}
