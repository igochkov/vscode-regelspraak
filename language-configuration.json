{
	"comments": {
		"lineComment": "//"
	},
	"brackets": [
		["(", ")"],
		["{", "}"],
		["«", "»"]
	],
	"autoClosingPairs": [
		{ "open": "(", "close": ")" },
		{ "open": "{", "close": "}" },
		{ "open": "«", "close": "»" },
		{ "open": "\"", "close": "\"" },
		{ "open": "'", "close": "'", "notIn": ["string", "comment"] }
	],
	"surroundingPairs": [
		["(", ")"],
		["{", "}"],
		["«", "»"],
		["\"", "\""],
		["'", "'"]
	],
	// Object form, because VS Code compiles the string form with no flags at
	// all: `\p{L}` would then be the literal characters, not a letter class,
	// and a double-click would select "p" instead of the word. Names carry
	// diacritics, so the class has to be Unicode-aware.
	"wordPattern": {
		"pattern": "[\\p{L}][\\p{L}\\p{N}_'-]*",
		"flags": "u"
	},
	"folding": {
		"markers": {
			"start": "^\\s*//\\s*#region\\b",
			"end": "^\\s*//\\s*#endregion\\b"
		}
	},
	"indentationRules": {
		"increaseIndentPattern": "(:\\s*$)|(^\\s*(Objecttype|Extensie van objecttype|Eenheidsysteem|Dimensie|Feittype|Wederkerig feittype|Regel|Beslistabel)\\b.*$)|(^\\s*[Gg]eldig\\b.*$)",
		"decreaseIndentPattern": "^\\s+[Gg]eldig\\b.*$"
	},
	"onEnterRules": [
		{
			"beforeText": "^\\s*•••\\s.*\\S.*$",
			"action": { "indent": "none", "appendText": "••• " }
		},
		{
			"beforeText": "^\\s*••\\s.*\\S.*$",
			"action": { "indent": "none", "appendText": "•• " }
		},
		{
			"beforeText": "^\\s*•\\s.*\\S.*$",
			"action": { "indent": "none", "appendText": "• " }
		},
		{
			"beforeText": "^\\s*\\.\\.\\s.*\\S.*$",
			"action": { "indent": "none", "appendText": ".. " }
		},
		{
			"beforeText": "^\\s*-\\s.*\\S.*,\\s*$",
			"action": { "indent": "none", "appendText": "- " }
		}
	]
}
