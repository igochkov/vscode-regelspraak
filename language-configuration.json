{
	"comments": {
		"lineComment": "//"
	},
	"brackets": [
		["(", ")"],
		["{", "}"],
		["«", "»"]
	],
	"autoClosingPairs": [
		{ "open": "(", "close": ")" },
		{ "open": "{", "close": "}" },
		{ "open": "«", "close": "»" },
		{ "open": "\"", "close": "\"" }
	],
	"surroundingPairs": [
		["(", ")"],
		["{", "}"],
		["«", "»"],
		["\"", "\""]
	],
	"wordPattern": "[\\p{L}][\\p{L}\\p{N}_'-]*"
}
