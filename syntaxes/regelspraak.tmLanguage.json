{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "RegelSpraak",
	"scopeName": "source.regelspraak",
	"patterns": [
		{
			"match": "//.*$",
			"name": "comment.line.double-slash.regelspraak"
		},
		{
			"match": "^\\s*---.*$",
			"name": "comment.line.section.koptekst.regelspraak"
		},
		{
			"begin": "\"",
			"end": "\"",
			"name": "string.quoted.double.regelspraak",
			"patterns": [
				{
					"begin": "«",
					"end": "»",
					"name": "meta.interpolation.regelspraak",
					"patterns": [
						{
							"include": "$self"
						}
					]
				}
			]
		},
		{
			"begin": "«",
			"end": "»",
			"name": "meta.interpolation.regelspraak",
			"patterns": [
				{
					"include": "$self"
				}
			]
		},
		{
			"match": "(?<![\\p{L}\\p{N}])'[^'\\r\\n]*'(?![\\p{L}])",
			"name": "string.quoted.single.enumeratiewaarde.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(Regel|Beslistabel)(?![\\p{L}\\p{N}'-])[ \\t]+([^\\r\\n]+)",
			"captures": {
				"1": {
					"name": "keyword.declaration.regelspraak"
				},
				"2": {
					"name": "entity.name.function.regelspraak"
				}
			}
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(Testset|Testgeval|[Tt]estinitialisatie)(?![\\p{L}\\p{N}'-])[ \t]+([^\r\n]+)",
			"captures": {
				"1": {
					"name": "keyword.declaration.regelspraak"
				},
				"2": {
					"name": "entity.name.function.regelspraak"
				}
			}
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(Objecttype|Extensie van objecttype|Wederkerig feittype|Feittype|Domein|Eenheidsysteem|Dimensie|Tijdlijn|Parameter|Dagsoort)(?![\\p{L}\\p{N}'-])[ \\t]+((?:de |het |een )?)(.*?)(?=\\s*(?:[(;:,]|heeft tijdvakken van|is van het type|bestaande uit de|$))",
			"captures": {
				"1": {
					"name": "keyword.declaration.regelspraak"
				},
				"3": {
					"name": "entity.name.type.regelspraak"
				}
			}
		},
		{
			"match": "(?:dd\\.\\s*)?\\d{1,2}-\\d{1,2}-\\d{4}(?:\\s+\\d{2}:\\d{2}:\\d{2}\\.\\d{3})?",
			"name": "constant.numeric.date.regelspraak"
		},
		{
			"match": "-?\\d+(?:,\\d+)?%",
			"name": "constant.numeric.percentage.regelspraak"
		},
		{
			"match": "-?\\d+(?:_\\d+)?/\\d+",
			"name": "constant.numeric.rationeel.regelspraak"
		},
		{
			"match": "-?\\d+(?:,\\d+)?",
			"name": "constant.numeric.regelspraak"
		},
		{
			"match": "•+",
			"name": "punctuation.definition.list.bullet.regelspraak"
		},
		{
			"match": "^\\s*-(?=\\s)",
			"name": "punctuation.definition.list.dash.regelspraak"
		},
		{
			"begin": "^[ \\t]*(\\|)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.separator.table.regelspraak"
				}
			},
			"end": "$",
			"name": "meta.table.beslistabel.regelspraak",
			"patterns": [
				{
					"match": "\\|",
					"name": "punctuation.separator.table.regelspraak"
				},
				{
					"match": "(?<=\\|)[ \\t]*\\d+[ \\t]*(?=\\|)",
					"name": "constant.numeric.rijnummer.regelspraak"
				},
				{
					"include": "$self"
				}
			]
		},
		{
			"match": "\\|",
			"name": "punctuation.separator.table.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:voor het attribuut zonder voorzetsel|na het attribuut met voorzetsel)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.declaration.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:Datum en tijd in millisecondes)(?![\\p{L}\\p{N}'-])",
			"name": "storage.type.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:moet geïnitialiseerd worden op|Als onverdeelde rest blijft|Er moet worden voldaan aan|er moet worden voldaan aan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:kleiner of gelijk zijn aan|eerder of gelijk zijn aan|groter of gelijk zijn aan|kleiner of gelijk is aan|later of gelijk zijn aan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:moet berekend worden als)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:Extensie van objecttype)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.declaration.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:eerder of gelijk is aan|groter of gelijk is aan|tijdsevenredig deel per|absolute tijdsduur van)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:het volgende criterium)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:later of gelijk is aan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:met variabel startpunt)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.declaration.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:moet gesteld worden op|waarbij wordt verdeeld|gedurende de tijd dat)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:kleiner of gelijk aan|als die er niet zijn|eerder of gelijk aan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:er wordt voldaan aan|even groot criterium)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:groter of gelijk aan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:heeft tijdvakken van)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.declaration.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:volgende voorwaarden)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:Wederkerig feittype)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.declaration.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:absolute waarde van)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:gedimensioneerd met)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.declaration.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:later of gelijk aan|maximale waarde van|met een maximum van|met een minimum van|minimale waarde van)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:volgende voorwaarde|wordt verdeeld over)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:eerste paasdag van|en een maximum van|gedeeld door \\(ABS\\))(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:wordt bepaald door)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:Testinitialisatie)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.declaration.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:het is de periode)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
