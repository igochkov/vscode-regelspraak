			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:moet voldoen aan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:aan de elfproef|aantal dagen in)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:de gehele maand)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:eerder zijn dan|gelijk zijn aan|groter zijn dan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:het gehele jaar)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:is van het type)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.declaration.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:ongelijk is aan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:op volgorde van)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:Datum in dagen)(?![\\p{L}\\p{N}'-])",
			"name": "storage.type.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:Eenheidsysteem)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.declaration.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:kleiner is dan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:laatstgenoemde)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.other.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:later zijn dan|verminderd met)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:Daarbij geldt)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:datumtijd met|eerder is dan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:eerstgenoemde)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.other.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:gelijk is aan|groter is dan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:naar rato van)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:niet-negatief)(?![\\p{L}\\p{N}'-])",
			"name": "storage.type.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:tijdsduur van)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.operator.wordlike.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:wordt voldaan)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.control.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:Gegevensbron)(?![\\p{L}\\p{N}'-])",
			"name": "keyword.declaration.regelspraak"
		},
		{
			"match": "(?<![\\p{L}\\p{N}'-])(?:gedeeld door)(?![\\p{L}\\p{N}'-])",
